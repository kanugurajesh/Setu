# Required. Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides. Any OpenAI-compatible endpoint works, e.g. a self-hosted
# vLLM server running gpt-oss-120b inside the partner's own cloud:
#   LLM_BASE_URL=http://vllm.internal:8000/v1
# LLM_BASE_URL=https://api.groq.com/openai/v1
# TEXT_MODEL=openai/gpt-oss-120b
# VISION_MODEL=qwen/qwen3.8-27b
# STT_MODEL=whisper-large-v3
# Key for a non-Groq server (falls back to GROQ_API_KEY)
# LLM_API_KEY=
# Set to off for models that reject reasoning_effort (e.g. qwen2.5 on Ollama)
# LLM_REASONING=on

# Total milliseconds for one AI step, retries included. Raise for slow local GPUs.
# LLM_TIMEOUT_MS=55000

# Proxies in front of the app that append to x-forwarded-for. Use 0 if it is exposed directly.
# TRUSTED_PROXY_HOPS=1

# Requests per IP per 5 minutes, per endpoint (best-effort, per instance)
# RATE_LIMIT=30
